stdout=serial
stderr=serial
stdin=serial

/* Remap partitions for fastboot. */
fastboot_partition_alias_misc=MISC
fastboot_partition_alias_uboot=expdb
fastboot_partition_alias_tee=tee2

fastboot_partition_alias_lk=INVALID
fastboot_partition_alias_lk_a=INVALID
fastboot_partition_alias_lk_b=INVALID

fastboot_partition_alias_tee1=INVALID

/*
 * Publish the device serial before anything else runs, so fastboot reports
 * it as serialno.
 */
preboot=idme get serial serial#

bootdelay=0
bootretry=1

/* Fastboot command */
fastboot=echo => FASTBOOT mode (u-boot)...; run device_pre_fb_cmd; \
	fastboot -l $fastboot_addr_r usb 0;

/* Enter fastboot if the board's fastboot button is held, otherwise boot. */
check_fastboot_key=if test -n "${fastboot_button}"; then \
		if button ${fastboot_button}; then \
			run fastboot; \
		fi; \
	fi

/* Setting cmdline args for Android userspace */
android_args=androidboot.verifiedbootstate=orange
set_android_slot=if test -n "${slot_suffix}"; then \
		setenv android_slot_args androidboot.slot_suffix=${slot_suffix}; \
		setenv android_normal_args androidboot.force_normal_boot=1; \
	fi

set_bootargs_normal=run set_android_slot; \
	setenv bootargs androidboot.serialno=${serial#} ${android_args} ${android_slot_args} \
		${android_normal_args} ${extra_bootargs}

set_bootargs_recovery=run set_android_slot; \
	setenv bootargs androidboot.serialno=${serial#} ${android_args} ${android_slot_args} \
		${extra_bootargs}

/* Various messages for boot fail */
recovery_failed=echo Recovery boot failed, falling back to fastboot...; run fastboot
boot_failed=echo Boot failed, falling back to fastboot...; run fastboot

boot_image=mmc dev 0 && \
	part start mmc 0 ${boot_part} boot_start && \
	part size mmc 0 ${boot_part} boot_size && \
	mmc read ${loadaddr} ${boot_start} ${boot_size} && \
	bootm ${loadaddr} ${loadaddr} ${fdtaddr}

bootcmd_android=setenv boot_part boot${slot_suffix} && \
	run set_bootargs_normal && run boot_image

bootcmd_recovery=setenv boot_part ${recovery_partition} && \
	run set_bootargs_recovery && run boot_image

check_recovery_key=if test -n "${recovery_button}"; then \
		if button ${recovery_button}; then run bootcmd_recovery || run recovery_failed; fi; \
	fi

/* Load bootloader message and check it. */
check_bcb=if bcb load 0 ${misc_partition}; then \
		run check_bcb_bootloader; \
		run check_bcb_recovery; \
	fi

check_bcb_bootloader=if bcb test command = bootonce-bootloader; then \
		bcb clear command; \
		bcb store; \
		run fastboot; \
	fi

check_bcb_recovery=if bcb test command = boot-recovery; then \
		run bootcmd_recovery || run recovery_failed; \
	fi

/*
 * No-opped on A-only devices, but make sure to include
 * A/B environment file AFTER this one.
 */
check_slot=true

/* The real boot command. */
bootcmd=run device_pre_bootcmd; run check_fastboot_key; \
	run check_recovery_key; run check_bcb; run check_slot; \
	run bootcmd_android || run boot_failed
