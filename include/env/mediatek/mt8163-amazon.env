stdin=serial,button-kbd
platform=mt8163

/* Remap partitions for fastboot */
fastboot_partition_alias_misc=MISC
fastboot_partition_alias_uboot=expdb
fastboot_partition_alias_tee=tee2

fastboot_partition_alias_lk=INVALID
fastboot_partition_alias_lk_a=INVALID
fastboot_partition_alias_lk_b=INVALID

fastboot_partition_alias_tee1=INVALID

/*
 * Publish the device serial before anything else runs, so fastboot reports
 * it as serialno.
 */
preboot=idme get serial serial#

/* Make sure we are always dropped into bootmenu */
bootdelay=0
bootretry=1

/* Custom bootmenu help text */
bootmenu_help=VOLUME UP / DOWN moves selected item, MUTE selects.

/* Fastboot command */
fastboot=echo => FASTBOOT mode (u-boot)...; run device_pre_fb_cmd; \
	run rootfs_map; fastboot -l $fastboot_addr_r usb 0;

/* Shortcut to enable USB serial gadget and disable bootretry */
serial_gadget=setenv stdin serial,button-kbd,usbacm; \
	setenv stdout serial,vidconsole,usbacm; \
	setenv stderr serial,vidconsole,usbacm; \
	setenv bootretry -1; \
	echo Enabled U-Boot console serial gadget

/* The real boot command */
bootcmd_real=run rootfs_map && \
	sysboot blkmap 0:1 any ${scriptaddr} /extlinux/extlinux.conf

boot_targets=blkmap

rootfs_map_part=part start mmc 0 ${rootfs_part} start && \
	part size mmc 0 ${rootfs_part} size && \
	setexpr start fmt %d ${start} && \
	blkmap map rootfs ${offset} ${size} linear mmc 0 ${start} && \
	setexpr offset ${offset} + ${size}

rootfs_create=blkmap create rootfs && \
	setenv offset 0 && \
	for rootfs_part in ${rootfs_parts}; do \
		run rootfs_map_part; \
	done

rootfs_map=blkmap get rootfs dev rootfs_dev || run rootfs_create
