stdin=serial,button-kbd
platform=mt8163

/* Make sure we are always dropped into bootmenu */
bootdelay=0
bootretry=1

/* Custom bootmenu help text */
bootmenu_help=VOLUME UP / DOWN moves selected item, MUTE selects.

/* Fastboot command */
fastboot=echo => FASTBOOT mode (u-boot)...; run device_pre_fb_cmd; fastboot -l $fastboot_addr_r usb 0;

/* Shortcut to enable USB serial gadget and disable bootretry */
serial_gadget=setenv stdin serial,button-kbd,usbacm; \
	setenv stdout serial,vidconsole,usbacm; \
	setenv stderr serial,vidconsole,usbacm; \
	setenv bootretry -1; \
	echo Enabled U-Boot console serial gadget

/*
 * We can set the real boot command here, but bootcmd is set to
 * bootmenu so that we re-enter the boot menu if something goes
 * wrong instead of leaving the user stuck at the console.
 *
 * TODO: Select DTB/DTBO dynamically based on device for this
 * boot method.
 */
bootcmd_android=mmc dev 0; \
	part start mmc 0 boot$slot_suffix boot_start; \
	part size mmc 0 boot$slot_suffix boot_size; \
	mmc read $loadaddr $boot_start $boot_size; \
	bootm $loadaddr $loadaddr $fdtaddr
