#include <env/mediatek/mt8163-amazon.env>

stdout=serial,vidconsole
stderr=serial,vidconsole

/* Headed device, present a bootmenu. */
bootcmd=run device_pre_bootcmd; bootmenu

/*
 * Set up custom bootmenu help text to make it more obvious
 * which buttons on the device navigate the menu.
 */
bootmenu_help=VOLUME UP / DOWN moves selected item, MUTE selects.

/* Pause is used so the output can be read on the display */
bootmenu_0=Boot=run bootcmd_android; pause
bootmenu_1=Enable serial console gadget=run serial_gadget
bootmenu_2=Enable fastboot mode=run fastboot
bootmenu_3=Drop to shell=setenv bootretry -1
bootmenu_4=Dump environment=printenv; pause
bootmenu_5=Board info=bdinfo; pause
bootmenu_6=Run ufetch=ufetch; pause
bootmenu_7=Reboot=reset
bootmenu_delay=3
bootmenu_default=0
