slotsel_failed=echo Slot selection failed, falling back to fastboot...; run fastboot

set_slot=amzn_bcb load 0 ${misc_partition} && \
	amzn_bcb boot_slot bcb_slot && \
	echo "Chosen slot from BCB: ${bcb_slot} (regardless of dump below)" && \
	amzn_bcb commit && \
	amzn_bcb dump && \
	setenv slot_suffix _${bcb_slot}

check_slot=run set_slot || run slotsel_failed
