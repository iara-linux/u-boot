#include <configs/mt8163-amazon-android.config>
CONFIG_MEMORY=y
CONFIG_MTK_SMI=y
CONFIG_SOC_MTK=y
CONFIG_MTK_MMSYS=y
CONFIG_MTK_MUTEX=y
CONFIG_DM_RESET=y
CONFIG_MISC=y
CONFIG_PHY_MTK_MIPI_DSI=y
CONFIG_DM_PWM=y
