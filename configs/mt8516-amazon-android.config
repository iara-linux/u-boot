CONFIG_ARM=y
CONFIG_SYS_BOARD="mt8516-amazon"
CONFIG_COUNTER_FREQUENCY=13000000
CONFIG_INIT_SP_RELATIVE=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_TEXT_BASE=0x41e00000
CONFIG_SYS_MALLOC_LEN=0x1000000
CONFIG_NR_DRAM_BANKS=2
CONFIG_DM_GPIO=y
CONFIG_TARGET_MT8516=y
CONFIG_SYS_LOAD_ADDR=0x50000000
CONFIG_IDENT_STRING="iara-linux"
# CONFIG_EFI_LOADER is not set
# CONFIG_BOOTSTD is not set
CONFIG_ANDROID_BOOT_IMAGE=y
CONFIG_EFI_PARTITION=y
CONFIG_ANDROID_BOOT_IMAGE_IGNORE_BLOB_ADDR=y
CONFIG_BOOT_RETRY=y
CONFIG_BOOT_RETRY_TIME=1
CONFIG_RETRY_BOOTCMD=y
CONFIG_OF_BOARD_SETUP=y
CONFIG_BOARD_LATE_INIT=y
CONFIG_HUSH_PARSER=y
CONFIG_USE_PREBOOT=y
CONFIG_CMD_IDME=y
CONFIG_CMD_BUTTON=y
CONFIG_CMD_BCB=y
CONFIG_CMD_MMC=y
CONFIG_CMD_PART=y
CONFIG_BUTTON=y
CONFIG_BUTTON_GPIO=y
# CONFIG_NET is not set
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_FASTBOOT_BUF_ADDR=0x50000000
CONFIG_FASTBOOT_BUF_SIZE=0x4000000
CONFIG_FASTBOOT_FLASH=y
CONFIG_FASTBOOT_FLASH_MMC_DEV=0
CONFIG_FASTBOOT_MMC_USER_SUPPORT=y
CONFIG_CLK=y
CONFIG_DM_I2C=y
CONFIG_SYS_I2C_MTK=y
CONFIG_MMC_HS200_SUPPORT=y
CONFIG_MMC_MTK=y
CONFIG_PHY=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_PINCTRL=y
CONFIG_PINCONF=y
CONFIG_PINCTRL_MT8516=y
CONFIG_POWER_DOMAIN=y
CONFIG_MT8516_POWER_DOMAIN=y
CONFIG_DM_REGULATOR=y
CONFIG_DM_REGULATOR_MT6323=y
CONFIG_BAUDRATE=921600
CONFIG_DM_SERIAL=y
CONFIG_MTK_SERIAL=y
CONFIG_USB=y
CONFIG_USB_MUSB_GADGET=y
CONFIG_USB_MUSB_MT85XX=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_MANUFACTURER="iara-linux"
CONFIG_USB_GADGET_VENDOR_NUM=0x18d1
CONFIG_USB_GADGET_PRODUCT_NUM=0x4ee0
CONFIG_WDT=y
CONFIG_WDT_MTK=y
CONFIG_PANIC_HANG=y
